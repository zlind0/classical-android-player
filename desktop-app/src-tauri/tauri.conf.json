{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora Desktop",
  "version": "0.1.0",
  "identifier": "com.aurora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aurora Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Aurora LAN library host",
    "longDescription": "Share music, audiobooks and ebooks over the local network using the Aurora library protocol."
  }
}
